# Site-specific redirects


# Freshwater Redirects
#RewriteCond %{HTTP_HOST} !^freshwater.uw\.edu [NC]
#RewriteRule .? - [S=0]

# SAFS Redirects
RewriteCond %{HTTP_HOST} !^fish.uw\.edu [NC]
RewriteRule .? - [S=1]
RewriteRule ^seas-open-house/?$ https://fish.uw.edu/alumni-community/students-explore-aquatic-sciences-seas/ [R=302,L]

# CIG Redirects
RewriteCond %{HTTP_HOST} !^cig.uw\.edu [NC]
RewriteRule .? - [S=1]
RewriteRule ^pnwc/?$ learn/ [R=301,L]

# Botanicgardens Redirects
RewriteCond %{HTTP_HOST} !^botanicgardens.uw\.edu [NC]
RewriteRule .? - [S=11]
RewriteRule ^rarecare/?.*$ https://botanicgardens.uw.edu/science-conservation/rarecare/ [L,R=301]
RewriteRule ^rentals/?$ https://botanicgardens.uw.edu/about/rental-space/ [L,R=301]
RewriteRule ^youth/?$ https://botanicgardens.uw.edu/education/youth-family/ [L,R=301]
RewriteRule ^arboretum/?$ https://botanicgardens.uw.edu/washington-park-arboretum/ [L,R=301]
RewriteRule ^cuh/?$ https://botanicgardens.uw.edu/center-for-urban-horticulture/ [L,R=301]
RewriteRule ^herbarium/?$ https://botanicgardens.uw.edu/center-for-urban-horticulture/visit/otis-douglas-hyde-herbarium/ [L,R=301]
RewriteRule ^ren/?$ https://botanicgardens.uw.edu/science-conservation/restoration-ecology-network/ [L,R=301]
RewriteRule ^map/?$ https://depts.washington.edu/uwbg/gardens/map.html [R=301,L]
RewriteRule ^farm/?$ https://botanicgardens.uw.edu/center-for-urban-horticulture/garens/uw-farm/ [R=301,L]
RewriteRule ^supportYFP/?$ https://www.washington.edu/giving/make-a-gift/?source_typ=3&source=WPAEDP [R=301,NC,L]
RewriteRule ^tram-tours/?$ https://botanicgardens.uw.edu/washington-park-arboretum/activities/tours/ [R=302,NC,L]

