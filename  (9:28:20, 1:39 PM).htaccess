deny from 31.207.44.186
# BEGIN WordPress

# More post requests throttling from single IP
<Limit POST>
    Order Allow,Deny
    Allow from all
    Deny from 115.192 115.206 116.89 42.56 115.204 183.128 31.207
</Limit>

<IfModule mod_rewrite.c>
RewriteEngine On

# block aws   
RewriteCond %{HTTP_REFERER} ^http://.*amazonaws\.com [OR]    
RewriteCond %{REMOTE_HOST} ^.*\.compute-1\.amazonaws\.com$ [NC,OR]  
RewriteCond %{REMOTE_HOST} ^.*\.compute\.amazonaws\.com$ [NC,OR]  
RewriteCond %{HTTP_USER_AGENT} "AISearchBot" [NC,OR]    
RewriteCond %{HTTP_USER_AGENT} "woriobot" [NC,OR]    
RewriteCond %{HTTP_USER_AGENT} "heritrix" [NC,OR]    
RewriteCond %{HTTP_USER_AGENT} "NetSeer" [NC,OR]
RewriteCond %{HTTP_USER_AGENT} "Rustbot/0.3" [NC,OR]
RewriteCond %{HTTP_USER_AGENT} "Nutch" [NC]    
RewriteRule ^(.*)$ - [F] 

# Begin Shibboleth
AuthType shibboleth
Require shibboleth
# End Shibboleth

<IfModule pagespeed_module>
    ModPagespeedDisallow https://dev.atmos.uw.edu/*
    ModPagespeedDisallow http://dev.atmos.uw.edu/*
</IfModule>

#don't look at our git
RewriteRule "^(.*/)?\.git/" - [F,L]
RedirectMatch 404 /\.git

# Added by request for UW-IT
RewriteRule ^(server-|PubCookie\.reply) - [L]

# block super aggresive baidu spider
RewriteCond %{HTTP_USER_AGENT} ^Baiduspider.* [NC]
RewriteRule .* - [F]

# deny malicious POST requests (2/23/18)

RewriteCond %{REQUEST_METHOD} POST [NC]
RewriteCond %{REQUEST_URI} !^.*/wp-admin/ [NC]
RewriteCond %{REQUEST_URI} !^.*/wp-cron.php [NC]
RewriteCond %{REQUEST_URI} !^.*/wp-login.php [NC]
# Whitelist XML-RPC Pingbacks, JetPack and Remote Posting POST Requests
RewriteCond %{REQUEST_URI} !^.*/xmlrpc.php [NC]
# Whitelist Jetpack JSON POST Request
RewriteCond %{REQUEST_URI} !^.*/wp-json/jetpack/(.*) [NC]
# Whitelist Network|Multisite Activate POST Form Requests
RewriteCond %{REQUEST_URI} !^.*/wp-activate.php [NC]
# Whitelist Trackback POST Requests
RewriteCond %{REQUEST_URI} !^.*/wp-trackback.php [NC]
# Whitelist Comments POST Form Requests
RewriteCond %{REQUEST_URI} !^.*/wp-comments-post.php [NC]
RewriteRule .* - [F,L]

# Increasing limits for giant menus - removed (4/12/18 - cbessee)
php_value max_input_vars 3000
php_value suhosin.get.max_vars 3000
php_value suhosin.post.max_vars 3000
php_value suhosin.request.max_vars 3000


