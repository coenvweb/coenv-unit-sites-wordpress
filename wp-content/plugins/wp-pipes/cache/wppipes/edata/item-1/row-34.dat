O:8:"stdClass":8:{s:5:"title";s:67:"Geophysicists prep for massive ‘ultrasound’ of Mount St. Helens";s:4:"link";s:101:"https://environment.uw.edu/news/2014/07/geophysicists-prep-for-massive-ultrasound-of-mount-st-helens/";s:11:"description";s:531:"<div>Scientists are gearing up to get started in earnest this weekend on a massive collaborative effort to map the internal plumbing of Mount St. Helens. The College of the Environment&rsquo;s Department of Earth and Space Sciences is playing a major role&ndash;lead by professor Kenneth Creager&ndash;along with numerous other institutions. The researcher&rsquo;s goal is to better understand the inner workings of the mountain and other volcanoes in the Cascade Range as in order to better protect nearby urban areas.&nbsp;</div>";s:6:"author";O:16:"SimplePie_Author":3:{s:4:"name";s:10:"John Meyer";s:4:"link";N;s:5:"email";N;}s:4:"date";s:19:"2014-07-16 20:16:14";s:10:"enclosures";a:1:{i:0;O:19:"SimplePie_Enclosure":27:{s:7:"bitrate";N;s:8:"captions";N;s:10:"categories";N;s:8:"channels";N;s:9:"copyright";N;s:7:"credits";N;s:11:"description";N;s:8:"duration";N;s:10:"expression";N;s:9:"framerate";N;s:7:"handler";N;s:6:"hashes";N;s:6:"height";N;s:10:"javascript";N;s:8:"keywords";N;s:4:"lang";N;s:6:"length";N;s:4:"link";N;s:6:"medium";N;s:6:"player";N;s:7:"ratings";N;s:12:"restrictions";a:1:{i:0;O:21:"SimplePie_Restriction":3:{s:12:"relationship";s:5:"allow";s:4:"type";N;s:5:"value";s:7:"default";}}s:12:"samplingrate";N;s:10:"thumbnails";N;s:5:"title";N;s:4:"type";N;s:5:"width";N;}}s:7:"src_url";s:101:"https://environment.uw.edu/news/2014/07/geophysicists-prep-for-massive-ultrasound-of-mount-st-helens/";s:8:"src_name";s:54:"Geophysicists prep for massive ‘ultrasound’ of ...";}