O:8:"stdClass":8:{s:5:"title";s:70:"How the ‘Beast Quake’ is helping scientists track real earthquakes";s:4:"link";s:105:"https://environment.uw.edu/news/2015/01/how-the-beast-quake-is-helping-scientists-track-real-earthquakes/";s:11:"description";s:459:"<div>It&rsquo;s not just the football players who have spent a year training. University of Washington seismologists will again be monitoring the ground-shaking cheers of Seahawks fans, this year with a bigger team, better technology and faster response times. Scientists with the Pacific Northwest Seismic Network will install instruments this Thursday to provide real-time monitoring of the stadium&rsquo;s movement during the 2015 NFL playoffs.&nbsp;</div>";s:6:"author";O:16:"SimplePie_Author":3:{s:4:"name";s:10:"John Meyer";s:4:"link";N;s:5:"email";N;}s:4:"date";s:19:"2015-01-06 22:34:56";s:10:"enclosures";a:1:{i:0;O:19:"SimplePie_Enclosure":27:{s:7:"bitrate";N;s:8:"captions";N;s:10:"categories";N;s:8:"channels";N;s:9:"copyright";N;s:7:"credits";N;s:11:"description";N;s:8:"duration";N;s:10:"expression";N;s:9:"framerate";N;s:7:"handler";N;s:6:"hashes";N;s:6:"height";N;s:10:"javascript";N;s:8:"keywords";N;s:4:"lang";N;s:6:"length";N;s:4:"link";N;s:6:"medium";N;s:6:"player";N;s:7:"ratings";N;s:12:"restrictions";a:1:{i:0;O:21:"SimplePie_Restriction":3:{s:12:"relationship";s:5:"allow";s:4:"type";N;s:5:"value";s:7:"default";}}s:12:"samplingrate";N;s:10:"thumbnails";N;s:5:"title";N;s:4:"type";N;s:5:"width";N;}}s:7:"src_url";s:105:"https://environment.uw.edu/news/2015/01/how-the-beast-quake-is-helping-scientists-track-real-earthquakes/";s:8:"src_name";s:54:"How the ‘Beast Quake’ is helping scientists tr ...";}