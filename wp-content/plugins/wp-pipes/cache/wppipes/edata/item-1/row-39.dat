O:8:"stdClass":8:{s:5:"title";s:79:"UW Climate Impacts Group plays major role in newest National Climate Assessment";s:4:"link";s:121:"https://environment.uw.edu/news/2014/05/uw-climate-impacts-group-plays-role-in-just-released-national-climate-assessment/";s:11:"description";s:516:"<div>The Obama Administration released the third National Climate Assessment, Climate Change Impacts in the United States, on May 6.&nbsp; Amy Snover, director of the Climate Impacts Group and assistant dean for applied research at the College of the Environment, served as a co-convening lead author of the assessment; additionally, the chapter focused on the Northwest drew heavily from the Climate Impact Group&rsquo;s body of research, including the 2009 Washington Climate Change Impacts Assessment.&nbsp;</div>";s:6:"author";O:16:"SimplePie_Author":3:{s:4:"name";s:10:"John Meyer";s:4:"link";N;s:5:"email";N;}s:4:"date";s:19:"2014-05-05 19:13:12";s:10:"enclosures";a:1:{i:0;O:19:"SimplePie_Enclosure":27:{s:7:"bitrate";N;s:8:"captions";N;s:10:"categories";N;s:8:"channels";N;s:9:"copyright";N;s:7:"credits";N;s:11:"description";N;s:8:"duration";N;s:10:"expression";N;s:9:"framerate";N;s:7:"handler";N;s:6:"hashes";N;s:6:"height";N;s:10:"javascript";N;s:8:"keywords";N;s:4:"lang";N;s:6:"length";N;s:4:"link";N;s:6:"medium";N;s:6:"player";N;s:7:"ratings";N;s:12:"restrictions";a:1:{i:0;O:21:"SimplePie_Restriction":3:{s:12:"relationship";s:5:"allow";s:4:"type";N;s:5:"value";s:7:"default";}}s:12:"samplingrate";N;s:10:"thumbnails";N;s:5:"title";N;s:4:"type";N;s:5:"width";N;}}s:7:"src_url";s:121:"https://environment.uw.edu/news/2014/05/uw-climate-impacts-group-plays-role-in-just-released-national-climate-assessment/";s:8:"src_name";s:54:"UW Climate Impacts Group plays major role in newes ...";}