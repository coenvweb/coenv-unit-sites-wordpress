O:8:"stdClass":8:{s:5:"title";s:68:"UW seismologists expand stadium monitoring for NFC championship game";s:4:"link";s:109:"https://environment.uw.edu/news/2014/01/uw-seismologists-expand-stadium-monitoring-for-nfc-championship-game/";s:11:"description";s:455:"<div>The Pacific Northwest Seismic Network installed a third seismograph at CenturyLink Field this week in the wake of the Seattle Seahawks win over the New Orleans Saints last weekend that provided a trial by fire of the network&rsquo;s website and new monitoring tools. Before last weekend&rsquo;s game, network scientists set up two near real-time seismic monitors at CenturyLink to augment data from a third seismograph about a block away.&nbsp;</div>";s:6:"author";O:16:"SimplePie_Author":3:{s:4:"name";s:10:"John Meyer";s:4:"link";N;s:5:"email";N;}s:4:"date";s:19:"2014-01-16 20:33:08";s:10:"enclosures";a:1:{i:0;O:19:"SimplePie_Enclosure":27:{s:7:"bitrate";N;s:8:"captions";N;s:10:"categories";N;s:8:"channels";N;s:9:"copyright";N;s:7:"credits";N;s:11:"description";N;s:8:"duration";N;s:10:"expression";N;s:9:"framerate";N;s:7:"handler";N;s:6:"hashes";N;s:6:"height";N;s:10:"javascript";N;s:8:"keywords";N;s:4:"lang";N;s:6:"length";N;s:4:"link";N;s:6:"medium";N;s:6:"player";N;s:7:"ratings";N;s:12:"restrictions";a:1:{i:0;O:21:"SimplePie_Restriction":3:{s:12:"relationship";s:5:"allow";s:4:"type";N;s:5:"value";s:7:"default";}}s:12:"samplingrate";N;s:10:"thumbnails";N;s:5:"title";N;s:4:"type";N;s:5:"width";N;}}s:7:"src_url";s:109:"https://environment.uw.edu/news/2014/01/uw-seismologists-expand-stadium-monitoring-for-nfc-championship-game/";s:8:"src_name";s:54:"UW seismologists expand stadium monitoring for NFC ...";}