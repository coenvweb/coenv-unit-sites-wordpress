O:8:"stdClass":8:{s:5:"title";s:65:"What does it take to catalogue every glacier in a mountain range?";s:4:"link";s:105:"https://environment.uw.edu/news/2015/06/what-does-it-take-to-catalogue-every-glacier-in-a-mountain-range/";s:11:"description";s:414:"<div>After days of waiting around in Port Angeles, Washington, Earth and Space Sciences&rsquo; T.J. Fudge finally got some good news: a helicopter would be able to drop him and another researcher into the wilderness of Olympic National Park. Fudge didn&rsquo;t know it yet, but nasty weather would prevent the helicopter from returning to pick them up, leaving the scientists no choice but to hike out.&nbsp;</div>";s:6:"author";O:16:"SimplePie_Author":3:{s:4:"name";s:16:"Jennifer Davison";s:4:"link";N;s:5:"email";N;}s:4:"date";s:19:"2015-06-17 18:24:18";s:10:"enclosures";a:1:{i:0;O:19:"SimplePie_Enclosure":27:{s:7:"bitrate";N;s:8:"captions";N;s:10:"categories";N;s:8:"channels";N;s:9:"copyright";N;s:7:"credits";N;s:11:"description";N;s:8:"duration";N;s:10:"expression";N;s:9:"framerate";N;s:7:"handler";N;s:6:"hashes";N;s:6:"height";N;s:10:"javascript";N;s:8:"keywords";N;s:4:"lang";N;s:6:"length";N;s:4:"link";N;s:6:"medium";N;s:6:"player";N;s:7:"ratings";N;s:12:"restrictions";a:1:{i:0;O:21:"SimplePie_Restriction":3:{s:12:"relationship";s:5:"allow";s:4:"type";N;s:5:"value";s:7:"default";}}s:12:"samplingrate";N;s:10:"thumbnails";N;s:5:"title";N;s:4:"type";N;s:5:"width";N;}}s:7:"src_url";s:105:"https://environment.uw.edu/news/2015/06/what-does-it-take-to-catalogue-every-glacier-in-a-mountain-range/";s:8:"src_name";s:54:"What does it take to catalogue every glacier in a  ...";}