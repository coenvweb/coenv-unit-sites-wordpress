O:8:"stdClass":8:{s:5:"title";s:67:"Predicting when toxic algae will reach Washington and Oregon coasts";s:4:"link";s:108:"https://environment.uw.edu/news/2014/09/predicting-when-toxic-algae-will-reach-washington-and-oregon-coasts/";s:11:"description";s:400:"<div>Late summer is the peak time for harmful algae that can turn lakes into toxic scum, cancelling fishing trips and fouling water supplies. While the Pacific Northwest doesn&rsquo;t get anything near the activity that turned parts of Lake Erie into bright green slime, our coasts are vulnerable in late summer to this largely unpredictable &ndash; and in our case unseen &ndash; menace.&nbsp;</div>";s:6:"author";O:16:"SimplePie_Author":3:{s:4:"name";s:10:"John Meyer";s:4:"link";N;s:5:"email";N;}s:4:"date";s:19:"2014-09-03 23:47:49";s:10:"enclosures";a:1:{i:0;O:19:"SimplePie_Enclosure":27:{s:7:"bitrate";N;s:8:"captions";N;s:10:"categories";N;s:8:"channels";N;s:9:"copyright";N;s:7:"credits";N;s:11:"description";N;s:8:"duration";N;s:10:"expression";N;s:9:"framerate";N;s:7:"handler";N;s:6:"hashes";N;s:6:"height";N;s:10:"javascript";N;s:8:"keywords";N;s:4:"lang";N;s:6:"length";N;s:4:"link";N;s:6:"medium";N;s:6:"player";N;s:7:"ratings";N;s:12:"restrictions";a:1:{i:0;O:21:"SimplePie_Restriction":3:{s:12:"relationship";s:5:"allow";s:4:"type";N;s:5:"value";s:7:"default";}}s:12:"samplingrate";N;s:10:"thumbnails";N;s:5:"title";N;s:4:"type";N;s:5:"width";N;}}s:7:"src_url";s:108:"https://environment.uw.edu/news/2014/09/predicting-when-toxic-algae-will-reach-washington-and-oregon-coasts/";s:8:"src_name";s:54:"Predicting when toxic algae will reach Washington  ...";}