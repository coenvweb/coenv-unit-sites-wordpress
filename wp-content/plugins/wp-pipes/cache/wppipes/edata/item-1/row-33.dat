O:8:"stdClass":8:{s:5:"title";s:48:"Oso disaster had its roots in earlier landslides";s:4:"link";s:89:"https://environment.uw.edu/news/2014/07/oso-disaster-had-its-roots-in-earlier-landslides/";s:11:"description";s:494:"<div>An interdisciplinary team of risk analysis experts, engineers, and scientists &mdash; including Earth and Spaces Sciences&rsquo; David Montgomery &mdash; released a report on Tuesday offering details about the Oso landslide that happened earlier this year. The&nbsp; report focuses on observations and data collection where the landslide occurred, reviews nearby geologic conditions and land-use and landslide risk assessments, and collects eyewitness accounts of the disaster.&nbsp;</div>";s:6:"author";O:16:"SimplePie_Author":3:{s:4:"name";s:10:"John Meyer";s:4:"link";N;s:5:"email";N;}s:4:"date";s:19:"2014-07-22 22:48:05";s:10:"enclosures";a:1:{i:0;O:19:"SimplePie_Enclosure":27:{s:7:"bitrate";N;s:8:"captions";N;s:10:"categories";N;s:8:"channels";N;s:9:"copyright";N;s:7:"credits";N;s:11:"description";N;s:8:"duration";N;s:10:"expression";N;s:9:"framerate";N;s:7:"handler";N;s:6:"hashes";N;s:6:"height";N;s:10:"javascript";N;s:8:"keywords";N;s:4:"lang";N;s:6:"length";N;s:4:"link";N;s:6:"medium";N;s:6:"player";N;s:7:"ratings";N;s:12:"restrictions";a:1:{i:0;O:21:"SimplePie_Restriction":3:{s:12:"relationship";s:5:"allow";s:4:"type";N;s:5:"value";s:7:"default";}}s:12:"samplingrate";N;s:10:"thumbnails";N;s:5:"title";N;s:4:"type";N;s:5:"width";N;}}s:7:"src_url";s:89:"https://environment.uw.edu/news/2014/07/oso-disaster-had-its-roots-in-earlier-landslides/";s:8:"src_name";s:48:"Oso disaster had its roots in earlier landslides";}