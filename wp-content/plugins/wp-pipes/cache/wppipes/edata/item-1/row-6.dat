O:8:"stdClass":8:{s:5:"title";s:101:"College of the Environment students, researchers at sea to learn more about deep-sea volcano eruption";s:4:"link";s:141:"https://environment.uw.edu/news/2015/07/college-of-the-environment-students-researchers-at-sea-to-learn-more-about-deep-sea-volcano-eruption/";s:11:"description";s:509:"<div>When the Axial Seamount, an&nbsp;underwater volcano, erupted off the coast of Oregon in&nbsp;April, researchers knew within minutes that something spectacular was happening more than 300 miles offshore. Precision hardware installed by the University of Washington last summer let scientists see its effects almost instantly from shore.&shy;&shy;&nbsp;A team of researchers, engineers and students is now at sea working t&shy;o maintain that equipment and assess the volcano&rsquo;s aftermath.&nbsp;</div>";s:6:"author";O:16:"SimplePie_Author":3:{s:4:"name";s:19:"Kelly Knickerbocker";s:4:"link";N;s:5:"email";N;}s:4:"date";s:19:"2015-07-14 20:25:25";s:10:"enclosures";a:1:{i:0;O:19:"SimplePie_Enclosure":27:{s:7:"bitrate";N;s:8:"captions";N;s:10:"categories";N;s:8:"channels";N;s:9:"copyright";N;s:7:"credits";N;s:11:"description";N;s:8:"duration";N;s:10:"expression";N;s:9:"framerate";N;s:7:"handler";N;s:6:"hashes";N;s:6:"height";N;s:10:"javascript";N;s:8:"keywords";N;s:4:"lang";N;s:6:"length";N;s:4:"link";N;s:6:"medium";N;s:6:"player";N;s:7:"ratings";N;s:12:"restrictions";a:1:{i:0;O:21:"SimplePie_Restriction":3:{s:12:"relationship";s:5:"allow";s:4:"type";N;s:5:"value";s:7:"default";}}s:12:"samplingrate";N;s:10:"thumbnails";N;s:5:"title";N;s:4:"type";N;s:5:"width";N;}}s:7:"src_url";s:141:"https://environment.uw.edu/news/2015/07/college-of-the-environment-students-researchers-at-sea-to-learn-more-about-deep-sea-volcano-eruption/";s:8:"src_name";s:54:"College of the Environment students, researchers a ...";}