O:8:"stdClass":8:{s:5:"title";s:64:"New knowledge and technology help scientists track harmful algae";s:4:"link";s:107:"https://environment.uw.edu/news/2015/05/new-knowledge-and-technology-help-scientists-track-poisonous-algae/";s:11:"description";s:477:"<div>Though the waters of Puget Sound are full of beneficial algae, which provide oxygen, food, and shelter for other creatures, it&rsquo;s the nasty ones that usually make the news, when they "bloom" into toxic pools, harming fish and humans. Now, researchers working with Washington Sea Grant have started to narrow in on harmful algae&rsquo;s behaviors, and are developing some slick techniques that they hope will lead to much more effective detection and monitoring.</div>";s:6:"author";O:16:"SimplePie_Author":3:{s:4:"name";s:16:"Jennifer Davison";s:4:"link";N;s:5:"email";N;}s:4:"date";s:19:"2015-05-11 20:44:13";s:10:"enclosures";a:1:{i:0;O:19:"SimplePie_Enclosure":27:{s:7:"bitrate";N;s:8:"captions";N;s:10:"categories";N;s:8:"channels";N;s:9:"copyright";N;s:7:"credits";N;s:11:"description";N;s:8:"duration";N;s:10:"expression";N;s:9:"framerate";N;s:7:"handler";N;s:6:"hashes";N;s:6:"height";N;s:10:"javascript";N;s:8:"keywords";N;s:4:"lang";N;s:6:"length";N;s:4:"link";N;s:6:"medium";N;s:6:"player";N;s:7:"ratings";N;s:12:"restrictions";a:1:{i:0;O:21:"SimplePie_Restriction":3:{s:12:"relationship";s:5:"allow";s:4:"type";N;s:5:"value";s:7:"default";}}s:12:"samplingrate";N;s:10:"thumbnails";N;s:5:"title";N;s:4:"type";N;s:5:"width";N;}}s:7:"src_url";s:107:"https://environment.uw.edu/news/2015/05/new-knowledge-and-technology-help-scientists-track-poisonous-algae/";s:8:"src_name";s:54:"New knowledge and technology help scientists track ...";}